{
  "name": "opencode-claude-memory",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenCode plugin: shared local Markdown memory with Claude Code, injected once per session (cache-friendly).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "claude",
    "claude-code",
    "claude-code-memory",
    "memory",
    "persistent-memory",
    "local-first",
    "markdown-memory"
  ],
  "license": "MIT",
  "devDependencies": {
    "@opencode/plugin": "2.2.5",
    "@types/node": "^26.1.2",
    "effect": "4.0.6",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.2.0",
    "effect": "^4.0.0"
  }
}
